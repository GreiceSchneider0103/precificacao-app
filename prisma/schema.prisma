generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Recomendado para migrações no Supabase
}

// --- AUTENTICAÇÃO (NextAuth) ---

enum UserRole {
  MASTER
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?
  role          UserRole  @default(MASTER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  settings      UserSettings?
  products      Product[]
  promotions    Promotion[]
  history       PricingHistory[]
  markupRules   MarkupRuleset[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- CONFIGURAÇÕES E REGRAS ---

model UserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  activeRuleId String
  rulesJson    String   // Considerar mudar para Json se possível futuramente
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarkupRuleset {
  id             String    @id @default(cuid())
  userId         String
  name           String
  isActive       Boolean   @default(false)
  data           Json
  tinyApiToken   String?   // Token da API v2 do Tiny ERP desta empresa
  tinyLastSyncAt DateTime? // Última sincronização de CMV bem-sucedida
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([userId])
  @@map("markup_settings_rulesets_v1") // Mantém o nome da tabela física
}

// --- PRODUTOS E LOGÍSTICA ---

model Product {
  id        String    @id @default(cuid())
  userId    String
  empresaId String?   // Empresa (MarkupRuleset) dona deste SKU no Tiny; null = legado/não atribuído
  sku       String
  name      String
  cmv       Decimal   @db.Decimal(10, 2) // Troca Float por Decimal
  mlb       String?   // Referência Mercado Livre
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Suporte a Soft Delete

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa MarkupRuleset? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@unique([userId, empresaId, sku]) // SKU único por empresa (não mais por conta inteira)
  @@index([userId, deletedAt]) // Index para performance em listagens "vivas"
  @@index([userId, empresaId])
}

// --- NEGÓCIO E PRECIFICAÇÃO ---

model Promotion {
  id            String   @id @default(cuid())
  userId        String
  sku           String
  name          String
  channel       String   // Canal de venda (Shopee, ML, etc)
  originalPrice Decimal  @db.Decimal(10, 2)
  promoPrice    Decimal  @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, channel, sku]) // Busca rápida de promoções por canal/produto
}

model PricingHistory {
  id             String   @id @default(cuid())
  userId         String
  sku            String
  name           String
  cmv            Decimal  @db.Decimal(10, 2)
  channel        String
  suggestedPrice Decimal  @db.Decimal(10, 2)
  finalPrice     Decimal  @db.Decimal(10, 2)
  margin         Decimal  @db.Decimal(5, 2) // Margem em percentual (ex: 15.50%)
  calculatedAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt])
  @@index([userId, sku]) // Rastro de preços por produto
}